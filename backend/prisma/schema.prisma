generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum DeviceStatus {
  AVAILABLE
  LINKED
  BLOCKED
  RETIRED
}

enum DeviceModelStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

model User {
  id          String  @id @default(uuid())
  username    String
  email       String  @unique
  password    String
  countryCode String
  phoneNo     String
  role        Role    @default(USER)
  verified    Boolean @default(false)

  otps        Otp[]
  sessions    Session[]
  userDevices UserDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Otp {
  id      String @id @default(uuid())
  email   String
  otpHash String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

model Session {
  id               String  @id @default(uuid())
  refreshTokenHash String
  ip               String
  userAgent        String
  revoked          Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model DeviceModel {
  id          String            @id @default(uuid())
  name        String
  code        String            @unique
  description String?
  version     String?
  status      DeviceModelStatus @default(ACTIVE)

  devices Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("device_models")
}

model Device {
  id String @id @default(uuid())

  deviceCode   String  @unique
  serialNumber String  @unique
  macAddress   String? @unique
  chipId       String? @unique

  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id])

  status DeviceStatus @default(AVAILABLE)

  batchNumber    String?
  manufacturedAt DateTime?

  linkedAt DateTime?

  credential DeviceCredential?
  telemetry  DeviceTelemetry[]

  userDevices UserDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceModelId])
  @@index([status])
  @@index([batchNumber])
  @@map("devices")
}

model DeviceCredential {
  id         String    @id @default(uuid())
  deviceId   String    @unique
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("device_credentials")
}

model DeviceTelemetry {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  temperature Float?
  humidity    Float?
  recordedAt  DateTime @default(now())

  @@index([deviceId])
  @@index([recordedAt])
  @@map("device_telemetry")
}

model UserDevice {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  name String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@map("user_devices")
}
